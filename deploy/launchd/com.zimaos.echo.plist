<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Service identifier -->
    <key>Label</key>
    <string>com.zimaos.echo</string>

    <!-- Program and arguments -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/zimaos-echo</string>
        <string>--config</string>
        <string>/usr/local/etc/zimaos-echo/config.yaml</string>
    </array>

    <!-- Working directory -->
    <key>WorkingDirectory</key>
    <string>/usr/local/var/zimaos-echo</string>

    <!-- Environment variables -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>ECHO_ENV</key>
        <string>production</string>
    </dict>

    <!-- Run at load (boot) -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Keep alive - restart if crashes -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <!-- Throttle restart attempts -->
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <!-- Logging -->
    <key>StandardOutPath</key>
    <string>/usr/local/var/log/zimaos-echo/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/usr/local/var/log/zimaos-echo/stderr.log</string>

    <!-- Resource limits -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>65536</integer>
        <key>NumberOfProcesses</key>
        <integer>4096</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>65536</integer>
        <key>NumberOfProcesses</key>
        <integer>4096</integer>
    </dict>

    <!-- Process type -->
    <key>ProcessType</key>
    <string>Background</string>

    <!-- Nice value (lower priority) -->
    <key>Nice</key>
    <integer>5</integer>

    <!-- Session type -->
    <key>LimitLoadToSessionType</key>
    <string>System</string>
</dict>
</plist>
