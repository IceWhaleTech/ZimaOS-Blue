{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZimaOS Blue",
  "mainBinaryName": "blue",
  "identifier": "com.zimaos.blue",
  "version": "0.10.28",
  "build": {
    "beforeBuildCommand": ""
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../web/dist": "dist"
    },
    "category": "Utility",
    "shortDescription": "AI Gateway for Local LLM Integration",
    "longDescription": "ZimaOS Blue is an AI gateway that provides seamless integration with local LLM providers like Ollama, enabling AI-powered features across your local network.",
    "copyright": "Copyright © 2024 ZimaOS Team",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "wix": null,
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "nsis/assets/header.bmp",
        "sidebarImage": "nsis/assets/sidebar.bmp",
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese",
          "TradChinese",
          "Japanese",
          "Korean",
          "German",
          "French",
          "Spanish",
          "SpanishInternational",
          "Portuguese",
          "PortugueseBR",
          "Italian",
          "Dutch",
          "Russian",
          "Polish",
          "Ukrainian",
          "Czech",
          "Slovak",
          "Hungarian",
          "Romanian",
          "Bulgarian",
          "Turkish",
          "Arabic",
          "Hebrew",
          "Thai",
          "Vietnamese",
          "Indonesian"
        ],
        "displayLanguageSelector": true
      }
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": []
      },
      "rpm": {
        "depends": []
      }
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ZimaOS Blue",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "url": "data:text/html,%3C!DOCTYPE html%3E%3Chtml%3E%3Cbody style='margin:0;background:%230F172A;display:flex;align-items:center;justify-content:center;height:100vh'%3E%3Cdiv style='width:36px;height:36px;border:3px solid %2394A3B8;border-top-color:%233B82F6;border-radius:50%25;animation:s .8s linear infinite'%3E%3C/div%3E%3Cstyle%3E@keyframes s{to{transform:rotate(360deg)}}@media(prefers-color-scheme:light){body{background:%23F8FAFC !important}div{border-color:%2364748B !important;border-top-color:%233B82F6 !important}}%3C/style%3E%3C/body%3E%3C/html%3E"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
