{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZimaOS Blue",
  "mainBinaryName": "blue",
  "identifier": "com.zimaos.blue",
  "version": "0.10.36",
  "build": {
    "beforeBuildCommand": ""
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../web/dist": "dist"
    },
    "category": "Utility",
    "shortDescription": "Open-Source Agent Runtime & Toolkit",
    "longDescription": "ZimaOS Blue is a fully open-source, auditable, and production-ready agent runtime and toolkit that lets you ship private, self-hosted agents with zero friction.",
    "copyright": "Copyright © 2026 ZimaOS Team",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "wix": null,
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "nsis/assets/header.bmp",
        "sidebarImage": "nsis/assets/sidebar.bmp",
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese",
          "TradChinese",
          "Japanese",
          "Korean",
          "German",
          "French",
          "Spanish",
          "SpanishInternational",
          "Portuguese",
          "PortugueseBR",
          "Italian",
          "Dutch",
          "Russian",
          "Polish",
          "Ukrainian",
          "Czech",
          "Slovak",
          "Hungarian",
          "Romanian",
          "Bulgarian",
          "Turkish",
          "Arabic",
          "Hebrew",
          "Thai",
          "Vietnamese",
          "Indonesian"
        ],
        "displayLanguageSelector": true
      }
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": "Developer ID Application: IceWhale Technology Limited (56349N8725)",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": []
      },
      "rpm": {
        "depends": []
      }
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "capabilities": [
        {
          "identifier": "desktop-localhost-ipc",
          "description": "Allow trusted localhost desktop pages to use Tauri IPC for native window actions.",
          "windows": ["main", "panel"],
          "remote": {
            "urls": [
              "http://localhost:*",
              "https://localhost:*",
              "http://127.0.0.1:*",
              "https://127.0.0.1:*"
            ]
          },
          "permissions": [
            "core:default",
            "core:window:allow-start-dragging",
            "notification:default"
          ]
        }
      ],
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
