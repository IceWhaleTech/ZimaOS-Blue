{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZimaOS Echo",
  "identifier": "com.zimaos.echo",
  "version": "0.10.22",
  "build": {
    "beforeBuildCommand": ""
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "AI Gateway for Local LLM Integration",
    "longDescription": "ZimaOS Echo is an AI gateway that provides seamless integration with local LLM providers like Ollama, enabling AI-powered features across your local network.",
    "copyright": "Copyright © 2024 ZimaOS Team",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": null,
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "nsis/assets/header.bmp",
        "sidebarImage": "nsis/assets/sidebar.bmp",
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese",
          "TradChinese",
          "Japanese",
          "Korean",
          "German",
          "French",
          "Spanish",
          "SpanishInternational",
          "Portuguese",
          "PortugueseBR",
          "Italian",
          "Dutch",
          "Russian",
          "Polish",
          "Ukrainian",
          "Czech",
          "Slovak",
          "Hungarian",
          "Romanian",
          "Bulgarian",
          "Turkish",
          "Arabic",
          "Hebrew",
          "Thai",
          "Vietnamese",
          "Indonesian"
        ],
        "displayLanguageSelector": true
      }
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": []
      },
      "rpm": {
        "depends": []
      }
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ZimaOS Echo",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "url": "about:blank"
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
